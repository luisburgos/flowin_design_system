{
  "$schema": "https://tr.designtokens.org/format/",
  "space": {
    "$type": "dimension",
    "$description": "Spacing scale (padding, gaps, fixed dimensions). Non-linear step scale named by token weight. From flutter_flowin FlowinDesignSpace. Button references space200/250/300/400/600.",
    "zero": { "$value": { "value": 0, "unit": "px" } },
    "50": { "$value": { "value": 2, "unit": "px" } },
    "100": { "$value": { "value": 4, "unit": "px" } },
    "150": { "$value": { "value": 6, "unit": "px" } },
    "200": { "$value": { "value": 8, "unit": "px" } },
    "250": { "$value": { "value": 10, "unit": "px" } },
    "300": { "$value": { "value": 12, "unit": "px" } },
    "400": { "$value": { "value": 16, "unit": "px" } },
    "600": { "$value": { "value": 24, "unit": "px" } }
  },
  "radius": {
    "$type": "dimension",
    "$description": "Corner-radius scale. From flutter_flowin FlowinDesignRadius. Button shape binds to radius.400.",
    "400": { "$value": { "value": 16, "unit": "px" } },
    "full": { "$value": { "value": 9999, "unit": "px" } }
  }
}
