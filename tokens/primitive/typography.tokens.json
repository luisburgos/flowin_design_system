{
  "$schema": "https://tr.designtokens.org/format/",
  "font": {
    "family": {
      "$type": "fontFamily",
      "baseline": {
        "$value": "Inter",
        "$description": "Baseline UI typeface \u2014 the family for all baseline text roles. See DESIGN.md for font-delivery guidance."
      },
      "brand": {
        "$value": "Supreme",
        "$description": "Expressive brand typeface \u2014 the family for the brand text roles (display, headline, and select title/body). See DESIGN.md for font-delivery guidance."
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      },
      "bold": {
        "$value": 700
      }
    }
  },
  "typography": {
    "$type": "typography",
    "$description": "Composite type tokens. lineHeight is a unitless ratio; letterSpacing kept as-authored in px (see DESIGN.md px\u2192em rule). `baseline` is the Inter UI scale; `brand` is the expressive Supreme scale.",
    "baseline": {
      "headlineSmall": {
        "$value": {
          "fontFamily": "{font.family.baseline}",
          "fontSize": {
            "value": 24,
            "unit": "px"
          },
          "fontWeight": "{font.weight.semibold}",
          "lineHeight": 1.3333333333333333,
          "letterSpacing": {
            "value": -0.05,
            "unit": "px"
          }
        }
      },
      "titleLarge": {
        "$description": "Bound like every other named baseline style: a transform installs it into the platform's corresponding type-scale slot. It was previously declared but not installed, so the slot resolved to nothing and native widgets reading it inherited from ambient text instead.",
        "$value": {
          "fontFamily": "{font.family.baseline}",
          "fontSize": {
            "value": 20,
            "unit": "px"
          },
          "fontWeight": "{font.weight.semibold}",
          "lineHeight": 1.2,
          "letterSpacing": {
            "value": 0,
            "unit": "px"
          }
        }
