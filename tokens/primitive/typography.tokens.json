{
  "$schema": "https://tr.designtokens.org/format/",
  "font": {
    "family": {
      "$type": "fontFamily",
      "baseline": {
        "$value": "Inter",
        "$description": "Baseline UI typeface — the family for all baseline text roles. See DESIGN.md for font-delivery guidance."
      },
      "brand": {
        "$value": "Supreme",
        "$description": "Expressive brand typeface — the family for the brand text roles (display, headline, and select title/body). See DESIGN.md for font-delivery guidance."
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    }
  },
  "typography": {
    "$type": "typography",
    "$description": "Composite type tokens. lineHeight is a unitless ratio; letterSpacing kept as-authored in px (see DESIGN.md px→em rule). `baseline` is the Inter UI scale; `brand` is the expressive Supreme scale.",
    "baseline": {
      "headlineSmall": {
        "$value": {
          "fontFamily": "{font.family.baseline}",
          "fontSize": { "value": 24, "unit": "px" },
          "fontWeight": "{font.weight.semibold}",
          "lineHeight": 1.3333333333333333,
          "letterSpacing": { "value": -0.05, "unit": "px" }
        }
      },
      "titleLarge": {
        "$description": "DECLARED BUT NOT BOUND. This style is defined here, but no component contract cites it and the reference implementation deliberately leaves the corresponding native slot at the platform's own default rather than overriding it with this value — carried forward from the production source, where it is a probable oversight. A transform MUST NOT install this style into a type-scale slot on the strength of its presence here; doing so silently diverges the rendered output from the reference. Tracked as a gap in DESIGN.md §5.",
        "$value": {
          "fontFamily": "{font.family.baseline}",
          "fontSize": { "value": 20, "unit": "px" },
          "fontWeight": "{font.weight.semibold}",
          "lineHeight": 1.2,
          "letterSpacing": { "value": 0, "unit": "px" }
        }
      },
      "titleMedium": {
        "$value": {
          "fontFamily": "{font.family.baseline}",
          "fontSize": { "value": 16, "unit": "px" },
          "fontWeight": "{font.weight.semibold}",
          "lineHeight": 1.375,
          "letterSpacing": { "value": 0, "unit": "px" }
        }
      },
      "titleSmall": {
        "$value": {
          "fontFamily": "{font.family.baseline}",
          "fontSize": { "value": 14, "unit": "px" },
          "fontWeight": "{font.weight.semibold}",
          "lineHeight": 1.4285714285714286,
          "letterSpacing": { "value": 0, "unit": "px" }
        }
      },
      "bodyLarge": {
        "$value": {
          "fontFamily": "{font.family.baseline}",
          "fontSize": { "value": 16, "unit": "px" },
          "fontWeight": "{font.weight.regular}",
          "lineHeight": 1.5,
          "letterSpacing": { "value": 0, "unit": "px" }
        }
      },
      "bodyMedium": {
        "$value": {
          "fontFamily": "{font.family.baseline}",
          "fontSize": { "value": 14, "unit": "px" },
          "fontWeight": "{font.weight.regular}",
          "lineHeight": 1.5714285714285714,
          "letterSpacing": { "value": 0, "unit": "px" }
        }
      },
      "labelLarge": {
        "$value": {
          "fontFamily": "{font.family.baseline}",
          "fontSize": { "value": 16, "unit": "px" },
          "fontWeight": "{font.weight.semibold}",
          "lineHeight": 1,
          "letterSpacing": { "value": 0, "unit": "px" }
        }
      },
      "labelMedium": {
        "$value": {
          "fontFamily": "{font.family.baseline}",
          "fontSize": { "value": 14, "unit": "px" },
          "fontWeight": "{font.weight.semibold}",
          "lineHeight": 1,
          "letterSpacing": { "value": 0, "unit": "px" }
        }
      },
      "labelSmall": {
        "$value": {
          "fontFamily": "{font.family.baseline}",
          "fontSize": { "value": 12, "unit": "px" },
          "fontWeight": "{font.weight.semibold}",
          "lineHeight": 1,
          "letterSpacing": { "value": 0, "unit": "px" }
        }
      },
      "captionLarge": {
        "$value": {
          "fontFamily": "{font.family.baseline}",
          "fontSize": { "value": 12, "unit": "px" },
          "fontWeight": "{font.weight.medium}",
          "lineHeight": 1.6666666666666667,
          "letterSpacing": { "value": 0, "unit": "px" }
        }
      },
      "captionMedium": {
        "$value": {
          "fontFamily": "{font.family.baseline}",
          "fontSize": { "value": 10, "unit": "px" },
          "fontWeight": "{font.weight.regular}",
          "lineHeight": 1.6,
          "letterSpacing": { "value": 0.2, "unit": "px" }
        }
      }
    },
    "brand": {
      "displayXL": {
        "$value": {
          "fontFamily": "{font.family.brand}",
          "fontSize": { "value": 160, "unit": "px" },
          "fontWeight": "{font.weight.bold}",
          "lineHeight": 1,
          "letterSpacing": { "value": -2, "unit": "px" }
        }
      },
      "displayLG": {
        "$value": {
          "fontFamily": "{font.family.brand}",
          "fontSize": { "value": 80, "unit": "px" },
          "fontWeight": "{font.weight.bold}",
          "lineHeight": 1,
          "letterSpacing": { "value": -1, "unit": "px" }
        }
      },
      "headlineLarge": {
